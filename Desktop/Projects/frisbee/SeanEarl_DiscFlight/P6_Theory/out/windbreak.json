{
  "heading": 270,
  "gates": {
    "G-W1": {
      "what": "mean sigma_u over the east third, disc band",
      "rule": "<= 0.75 x baseline",
      "threshold": 0.75,
      "direction": "below"
    },
    "G-W2": {
      "what": "mean sigma_u over each third, disc band",
      "rule": "<= 1.10 x baseline in every third",
      "threshold": 1.1,
      "direction": "below"
    },
    "G-W3": {
      "what": "pitch-mean horizontal |U|, disc band",
      "rule": ">= 0.50 x baseline",
      "threshold": 0.5,
      "direction": "above"
    },
    "G-W4": {
      "what": "pitch-max |d sigma_u/dz| inside the disc band",
      "rule": "<= 1.50 x baseline",
      "threshold": 1.5,
      "direction": "below"
    },
    "G-W5": {
      "what": "paired landing dispersion of the standard throw",
      "rule": "< 1.00 x baseline",
      "threshold": 1.0,
      "direction": "below"
    },
    "G-W6": {
      "what": "G-W2 and G-W3 at theta_wind 90 and 210",
      "rule": "both pass at both headings",
      "threshold": null,
      "direction": null
    }
  },
  "designs": {
    "W1": {
      "name": "shelterbelt",
      "x": 21.0,
      "height": 5.0,
      "k_r": 3.0,
      "idea": "a porous fence on the east-third boundary, sheltering the affected zone from upwind in the classic shelterbelt way"
    },
    "W2": {
      "name": "tower deflector",
      "x": 52.0,
      "height": 10.0,
      "k_r": 3.0,
      "idea": "a porous screen 4 m in front of Campus Towers' windward face, breaking the stagnation up before it forms rather than shielding the field from it"
    },
    "W3": {
      "name": "low open spoiler",
      "x": 30.0,
      "height": 3.0,
      "k_r": 1.78,
      "idea": "a low, more open barrier meant to lift the shear layer above the disc band instead of blocking the flow"
    },
    "W4": {
      "name": "tall tower screen",
      "x": 52.0,
      "height": 25.0,
      "k_r": 3.0,
      "idea": "the same position as W2 at 0.56 H instead of 0.22 H, testing whether the barrier must scale with the building rather than with the disc band"
    }
  },
