/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class volScalarField; object omega; }

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletEpsilon;   // converted -> omega in OF
        flowDir         (1 0 0);
        zDir            (0 0 1);
        Uref            5.0;
        Zref            10;
        z0              uniform 0.001;
        zGround         uniform 0;
        value           uniform 1;
    }
    outlet    { type zeroGradient; }
    top       { type slip; }
    "(north|south)" { type slip; }
    "(ground|buildings|trees)"
    {
        type            omegaWallFunction;
        value           $internalField;
    }
}
