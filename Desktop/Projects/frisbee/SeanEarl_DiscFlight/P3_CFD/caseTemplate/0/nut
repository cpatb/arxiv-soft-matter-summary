/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class volScalarField; object nut; }

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    inlet     { type calculated; value $internalField; }
    outlet    { type calculated; value $internalField; }
    top       { type slip; }
    "(north|south)" { type slip; }
    "(ground|buildings|trees)"
    {
        type    atmNutkWallFunction;
        z0      uniform 0.001;          // patched per direction
        value   $internalField;
    }
}
