/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class volVectorField; object U; }

// Richards-Hoxey atmospheric BL log-profile.
// Patched by generateCases.py for each inflow direction.

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletVelocity;
        flowDir         (1 0 0);          // PATCH: per-direction
        zDir            (0 0 1);
        Uref            5.0;              // PATCH: u at z_ref
        Zref            10;
        z0              uniform 0.001;    // PATCH: 0.001 lake / 0.5 urban
        zGround         uniform 0;
        value           uniform (5 0 0);  // PATCH: per-direction
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }
    top
    {
        type            slip;
    }
    "(north|south)"
    {
        type            slip;
    }
    "(ground|buildings|trees)"
    {
        type            noSlip;
    }
}
