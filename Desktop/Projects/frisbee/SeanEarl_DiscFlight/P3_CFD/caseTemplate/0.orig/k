/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class volScalarField; object k; }

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform @@KINIT@@;

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletK;
        flowDir         (1 0 0);
        zDir            (0 0 1);
        Uref            @@UREF@@;
        Zref            @@ZREF@@;
        z0              uniform @@Z0_INLET@@;
        d               uniform 0;
        zGround         uniform 0;
        value           $internalField;
    }
    outlet          { type zeroGradient; }
    top             { type slip; }
    "(north|south)" { type slip; }
    "(ground|buildings)"
    {
        type            kqRWallFunction;
        value           $internalField;
    }
}
