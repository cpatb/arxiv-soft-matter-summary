/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }

// Background hex mesh. Values substituted by generateCases.py.
//
// Domain sizing follows COST Action 732 / Tominaga et al. (2008) with
// H = 60.8 m (Mertz Hall), the tallest building inside the modelled r <= 300 m
// building set. Which criteria are met and which are relaxed is recorded in
// case_info.txt for every case.

scale 1;

xMin @@XMIN@@;  xMax @@XMAX@@;
yMin @@YMIN@@;  yMax @@YMAX@@;
zMin @@ZMIN@@;  zMax @@ZMAX@@;

nx @@NX@@; ny @@NY@@; nz @@NZ@@;

// Vertical grading: cells are clustered toward the ground so the disc-altitude
// band (1-6 m AGL) is resolved without paying for fine cells at 300 m.
// @@ZRATIO@@ is the last/first cell ratio, giving a @@ZFIRST@@ m first cell.
zRatio @@ZRATIO@@;

vertices
(
    ($xMin $yMin $zMin)
    ($xMax $yMin $zMin)
    ($xMax $yMax $zMin)
    ($xMin $yMax $zMin)
    ($xMin $yMin $zMax)
    ($xMax $yMin $zMax)
    ($xMax $yMax $zMax)
    ($xMin $yMax $zMax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 $zRatio)
);

edges ();

boundary
(
    inlet   { type patch; faces ( (0 4 7 3) ); }   // west  (-x): flow enters
    outlet  { type patch; faces ( (1 2 6 5) ); }   // east  (+x)
    north   { type patch; faces ( (3 7 6 2) ); }
    south   { type patch; faces ( (0 1 5 4) ); }
    top     { type patch; faces ( (4 5 6 7) ); }
    ground  { type wall;  faces ( (0 3 2 1) ); }
);
