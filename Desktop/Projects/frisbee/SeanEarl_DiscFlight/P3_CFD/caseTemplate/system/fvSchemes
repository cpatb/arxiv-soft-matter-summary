/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object fvSchemes; }

ddtSchemes      { default steadyState; }

gradSchemes
{
    default         Gauss linear;
    grad(U)         cellLimited Gauss linear 1;
}

divSchemes
{
    default                       none;
    div(phi,U)                    bounded Gauss linearUpwindV grad(U);
    div(phi,k)                    bounded Gauss limitedLinear 1;
    div(phi,omega)                bounded Gauss limitedLinear 1;
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

// snappyHexMesh on real building footprints leaves some high-non-orthogonality
// cells; "limited 0.33" is the standard robust choice for such meshes.
laplacianSchemes    { default Gauss linear limited 0.33; }
interpolationSchemes{ default linear; }
snGradSchemes       { default limited 0.33; }
wallDist            { method meshWave; }
