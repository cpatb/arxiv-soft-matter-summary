/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         @@ENDTIME@@;
deltaT          1;
writeControl    timeStep;
writeInterval   @@WRITEINTERVAL@@;
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p k omega);
        writeResidualFields false;
    }

    // Mean speed at disc altitude over the field, monitored for convergence.
    fieldAverageProbe
    {
        type            probes;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   20;
        fields          (U k);
        probeLocations  ( (0 0 2) (-20 0 2) (20 0 2) (0 0 5) );
    }
}
