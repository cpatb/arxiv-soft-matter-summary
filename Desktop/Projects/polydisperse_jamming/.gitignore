*.pyc

# Per-worker sweep console logs. The scientific content lives in the .jsonl
# records and the *_verdict.txt files; these are the interleaved stdout of up to
# 12 parallel workers and regenerate on any re-run.
out/*_w[0-9][0-9].log
out/calib_cost.log
out/diag_*.log
out/phase4_impact.log
shear_pre_refactor_src.txt
shear_pre_refactor.py

# LaTeX build artifacts of the manuscript under paper/. main.pdf is rebuilt by
# `latexmk -pdf main` from committed sources; the figure PDFs under paper/figures ARE committed.
paper/main.aux
paper/main.bbl
paper/main.blg
paper/main.fdb_latexmk
paper/main.fls
paper/main.log
paper/main.out
paper/main.pdf
paper/mainNotes.bib
paper/build.log
